32
create bin data.bin "01 02 03"
stat data.bin
read data.bin 0 3
read data.bin 1 2
write data.bin 1 "FF"
read data.bin 0 3
write data.bin 3 "AA BB"
read data.bin 0 5
truncate data.bin 3
read data.bin 0 3
truncate data.bin 6
read data.bin 0 6
create bin backup.bin "01 02 03"
top 3
undo
read data.bin 0 6
top 3
create txt note.txt "hello"
append note.txt " world"
cat note.txt
create txt full.txt ""
create txt extra.txt "!"
concat full.txt note.txt extra.txt
cat full.txt
top 5
stat full.txt
read data.bin 2 2
read data.bin 0 7
stat missing.bin
undo
top 5
ls
